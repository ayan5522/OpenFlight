// Copy to config.h and fill in your Wi-Fi credentials.
// config.h is listed in .gitignore — do not commit secrets.

#ifndef OPENFLIGHT_CONFIG_H
#define OPENFLIGHT_CONFIG_H

#define WIFI_SSID     "YOUR_SSID"
#define WIFI_PASSWORD "YOUR_PASSWORD"

#define TCP_SERVER_PORT 5000

// ST7789 — 2.4" 240x320 SPI (landscape via setRotation(1))
#define TFT_CS    5
#define TFT_DC    2
#define TFT_RST   4
#define TFT_MOSI  23
#define TFT_MISO  19
#define TFT_SCK   18

#define FG_STALE_TIMEOUT_MS 3000

#endif
